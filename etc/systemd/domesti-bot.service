# User systemd unit for domesti-bot (HTTP API + web UI).
#
# repository-helpers ``setup-service`` substitutes ``@@REPO_DIR@@`` with the
# git worktree path, installs to ``~/.config/systemd/user/``, enables linger,
# and runs ``scripts/on-deploy`` before (re)start. Same pattern as fpdf's
# ``etc/systemd/fpdf.service`` (``--listen-all`` so other hosts reach port 8003
# when nginx is not on this machine).
#
# Port 8003 on all interfaces. Keep ``ExecStart`` and ``ExecStartPost`` ports
# aligned if you change either.
#
# ``ExecStartPost`` hits ``GET /health`` on loopback; that still works when the
# server binds ``0.0.0.0:8003`` because the stack accepts ``127.0.0.1:8003``.
#
# Logs: ``~/scratch/domesti-bot/domesti-bot.log`` (``setup-service`` also
# ensures ``~/scratch/domesti-bot/`` exists).
#
# Secrets (``TAILWIND_TOKEN``, ``KASA_*``, ``DOMESTI_API_KEY``, and optionally
# ``DOMESTI_ADMIN_API_KEY`` / ``DOMESTI_READ_API_KEY`` to scope the API): use
# ``systemctl --user edit domesti-bot`` and set ``EnvironmentFile=`` to a
# mode-600 file under your home directory, or export them via
# ``~/.config/environment.d/*.conf`` (see docs/AGENTS.md Security).

[Unit]
Description=domesti-bot - home automation service
After=network.target
StartLimitIntervalSec=100
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=@@REPO_DIR@@
ExecStart=@@REPO_DIR@@/scripts/domesti-bot-server --listen-all --listen-port 8003 --no-browser
Restart=always
RestartSec=5
StandardOutput=append:%h/scratch/domesti-bot/domesti-bot.log
StandardError=append:%h/scratch/domesti-bot/domesti-bot.log
ExecStartPost=/usr/bin/curl --silent --fail --max-time 5 --retry 12 --retry-delay 1 --retry-connrefused http://127.0.0.1:8003/health

# Baseline hardening (domesti-bot#879, #909). ``NoNewPrivileges`` is enforced everywhere.
# ``RestrictAddressFamilies`` is enforced on x86-64 and aarch64 but ignored on 32-bit x86, s390, s390x, mips and ppc ABIs,
# and it does not cover 32-bit calls on a host that also runs 32-bit x86 code, so it is paired with
# ``SystemCallArchitectures=native``. ``PrivateTmp`` and ``ProtectSystem`` need a mount namespace, which a user
# manager builds inside an unprivileged user namespace: where that is not allowed
# (``kernel.apparmor_restrict_unprivileged_userns=1``) systemd starts the unit without them and without an error, so
# they take effect only on hosts that allow it (see the unit hardening note in docs/AGENTS.md for how to check).
# ``ProtectHome`` and ``ProtectSystem=strict`` stay off on purpose: the service writes its log, discovery cache and
# rules under the home directory and its checkout. ``AF_NETLINK`` is the C library's interface listing (mDNS, SSDP
# and UDP discovery); raw packet sockets are not used.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
SystemCallArchitectures=native

[Install]
WantedBy=default.target
