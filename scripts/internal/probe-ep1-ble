#!/usr/bin/env python3
"""Run the EP1 BLE probe in the project's uv environment."""

from __future__ import annotations

import os
import shutil
import sys
from pathlib import Path


def main() -> int:
    """Re-exec the probe module in the managed environment."""
    module_path = Path(__file__).with_name("probe_ep1_ble.py")
    if os.environ.get("UV_ACTIVE") or "/.venv/" in (sys.executable or ""):
        os.execv(sys.executable, [sys.executable, str(module_path), *sys.argv[1:]])
    uv = shutil.which("uv")
    if uv:
        os.execv(uv, [uv, "run", "python", str(module_path), *sys.argv[1:]])
    print("Expected uv on PATH for probe-ep1-ble", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
