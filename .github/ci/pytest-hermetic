#!/usr/bin/env bash
# Hermetic pytest run for CI.
#
# A pytest-xdist worker that dies without a traceback ("worker 'gw2' crashed while
# running '<node id>'", issue #936) fails the whole job even though every other test
# passed. When every failure in the log is such a crash, rerun exactly those tests
# once, by node id, so a runner-level flake does not discard the run. The job stays
# red when any ordinary failure or error is present (those are never retried), when no
# crashed node id can be read from the log, and when a crashed test fails again.
#
# Known limit: a test killed by the pytest-timeout "thread" method (pyproject.toml,
# issue #675) is indistinguishable here. The worker exits through os._exit, the
# timeout banner stays on the worker's own terminal, and the controller log reads
# exactly like a native crash. Such a hang is therefore retried once too: a hang that
# repeats fails the rerun and keeps the job red, and the warning annotation names every
# retried test so it stays visible. The rerun spends time from the job's 15-minute
# budget, so it is limited to the crashed tests.
set -euo pipefail
# Temp files and caches follow $TMPDIR/<project>/<branch>/<tool> (repository-helpers#832).
# CI exports REPOSITORY_HELPERS_DIR through the setup-tmp-layout action; without a clone, run unchanged.
layout_bin="${REPOSITORY_HELPERS_DIR:-$HOME/work/ai/repository-helpers}/scripts/dev/with-tmp-layout"
if [[ -z "${CI_TMP_LAYOUT:-}" ]]; then
  if [[ -x "$layout_bin" ]]; then
    CI_TMP_LAYOUT=1 exec "$layout_bin" uv -- "$layout_bin" pytest -- bash "$0" "$@"
  elif [[ "${GITHUB_ACTIONS:-}" == true ]]; then
    echo 'ERROR: with-tmp-layout missing; add the setup-tmp-layout action step before this one' >&2
    exit 1
  fi
fi
bash .github/ci/setup-python

readonly marker_filter='not integration and not browser'
log="$(mktemp "${TMP_LAYOUT_DIR:-${TMPDIR:-/tmp}}/pytest-log.XXXXXX")"
readonly log
trap 'rm -f "$log"' EXIT

set +e
uv run pytest -m "$marker_filter" -n auto --durations=20 2>&1 | tee "$log"
status="${PIPESTATUS[0]}"
set -e

if [[ "$status" -eq 0 ]]; then
  exit 0
fi

mapfile -t crashed_ids < <(grep -oE "crashed while running '[^']+'" "$log" | sed -E "s/^crashed while running '(.*)'\$/\\1/" | sort -u)
if [[ "${#crashed_ids[@]}" -eq 0 ]]; then
  exit "$status"
fi

# A crash produces exactly one summary line for its test. Count the lines per crashed id:
# the first is the crash, any further FAILED or ERROR line for the same test (for example
# an assertion that failed before the worker died in teardown) is an ordinary failure and
# blocks the rerun. The message is not read at all, because pytest trims it to the
# terminal width and, for a long parametrized id, can cut it to "..." or drop it
# ("FAILED <id> - worker 'gw0' c...", "FAILED <id> - ...", "FAILED <id>"). The id is
# matched as a prefix instead of being cut out of the line, because a parametrized id may
# itself contain " - ".
declare -A lines_per_crashed_id=()
other_failures=0
while IFS= read -r summary_line; do
  matched_id=""
  if [[ "$summary_line" == FAILED\ * ]]; then
    for crashed_id in "${crashed_ids[@]}"; do
      if [[ "$summary_line" == "FAILED $crashed_id - "* || "$summary_line" == "FAILED $crashed_id" ]]; then
        matched_id="$crashed_id"
        break
      fi
    done
  fi
  if [[ -z "$matched_id" ]]; then
    other_failures=$((other_failures + 1))
    continue
  fi
  lines_per_crashed_id["$matched_id"]=$(( ${lines_per_crashed_id["$matched_id"]:-0} + 1 ))
  if (( lines_per_crashed_id["$matched_id"] > 1 )); then
    other_failures=$((other_failures + 1))
  fi
done < <(grep -E '^(FAILED|ERROR) ' "$log" || true)

if [[ "$other_failures" -ne 0 ]]; then
  echo "pytest-hermetic: $other_failures failure(s) besides the worker crash, not rerunning (issue #936)"
  exit "$status"
fi

echo "::warning title=pytest worker crash::an xdist worker crashed or was killed by pytest-timeout (issue #936); rerunning once: ${crashed_ids[*]}"
uv run pytest -m "$marker_filter" -n 0 "${crashed_ids[@]}"
echo "::warning title=pytest worker crash::the rerun passed, so the crash was a runner-level flake; see issue #936"
