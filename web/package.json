{
  "name": "@domesti-bot/web",
  "version": "0.0.0",
  "private": true,
  "description": "Browser bundle for the domesti-bot HTTP API.",
  "type": "module",
  "scripts": {
    "build": "node scripts/rasterize-pwa-icons.mjs && node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "test": "esbuild src/api-keys.ts src/settings-secret-field.ts --format=esm --outdir=.test-build --out-extension:.js=.mjs --log-level=warning && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.22",
    "esbuild": "0.28.2",
    "sharp": "0.35.5",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "dependencies": {
    "leaflet": "1.9.4"
  }
}
